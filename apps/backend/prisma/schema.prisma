generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  BLOCKED
}

enum StockItemStatus {
  ACTIVE
  INACTIVE
}

enum StockItemType {
  PRODUCT
  RAW_MATERIAL
  PACKAGING
  SERVICE
  OTHER
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  name          String
  status        UserStatus       @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  refreshTokens RefreshToken[]
  stockExports       StockExportJob[]
  onlineStoreSyncJobs OnlineStoreSyncJob[]
  saleCarts          SaleCart[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  promotionAudits    PromotionAuditLog[]
  receivablesCreated AccountReceivable[] @relation("ReceivableCreator")
  receivableMovements ReceivableMovement[]
  receivableAudits   ReceivableAuditLog[]
  payablesCreated    AccountPayable[] @relation("PayableCreator")
  payableMovements   PayableMovement[]
  payableAudits      PayableAuditLog[]
  payableApprovals   PayableApproval[] @relation("PayableApprover")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

model StockCategory {
  id        String      @id @default(cuid())
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StockItem[]

  @@unique([name])
  @@map("stock_categories")
}

model StockBrand {
  id        String      @id @default(cuid())
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StockItem[]

  @@unique([name])
  @@map("stock_brands")
}

model StockLocation {
  id        String      @id @default(cuid())
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StockItem[]
  lots      StockLot[]

  @@unique([name])
  @@map("stock_locations")
}

model UnitOfMeasure {
  id           String      @id @default(cuid())
  code         String
  label        String
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  measureItems StockItem[] @relation("ItemMeasureUnit")
  purchaseItems StockItem[] @relation("ItemPurchaseUnit")
  saleItems    StockItem[] @relation("ItemSaleUnit")

  @@unique([code])
  @@map("units_of_measure")
}

model StockItem {
  id                       String          @id @default(cuid())
  code                     String
  description              String
  sku                      String?
  barcode                  String?
  status                   StockItemStatus @default(ACTIVE)
  itemType                 StockItemType   @default(PRODUCT)

  categoryId               String?
  category                 StockCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId                  String?
  brand                    StockBrand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  locationId               String?
  location                 StockLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  measureUnitId            String?
  measureUnit              UnitOfMeasure?  @relation("ItemMeasureUnit", fields: [measureUnitId], references: [id], onDelete: SetNull)
  purchaseUnitId           String?
  purchaseUnit             UnitOfMeasure?  @relation("ItemPurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: SetNull)
  saleUnitId               String?
  saleUnit                 UnitOfMeasure?  @relation("ItemSaleUnit", fields: [saleUnitId], references: [id], onDelete: SetNull)
  purchaseToMeasureFactor  Decimal?        @db.Decimal(18, 6)
  saleToMeasureFactor      Decimal?        @db.Decimal(18, 6)

  trackStock               Boolean         @default(true)
  minStock                 Decimal?        @db.Decimal(18, 4)
  maxStock                 Decimal?        @db.Decimal(18, 4)
  currentStock             Decimal         @default(0) @db.Decimal(18, 4)
  trackLot                 Boolean         @default(false)
  trackExpiry              Boolean         @default(false)

  costPrice                Decimal?        @db.Decimal(18, 4)
  salePrice                Decimal?        @db.Decimal(18, 4)

  ncm                      String?
  cest                     String?
  origin                   String?
  defaultCfop              String?
  fiscalUnit               String?

  complementaryDescription String?
  notes                    String?
  manufacturer             String?
  mainSupplier             String?

  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  lots                     StockLot[]
  onlineListings           OnlineStoreListing[]
  saleCartItems            SaleCartItem[]

  @@unique([code])
  @@unique([sku])
  @@unique([barcode])
  @@index([description])
  @@index([status])
  @@index([itemType])
  @@index([categoryId])
  @@index([brandId])
  @@index([locationId])
  @@index([measureUnitId])
  @@map("stock_items")
}

model StockLot {
  id                 String         @id @default(cuid())
  itemId             String
  item               StockItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotNumber          String
  manufacturingDate  DateTime?      @db.Date
  expiryDate         DateTime       @db.Date
  quantity           Decimal        @db.Decimal(18, 4)
  locationId         String?
  location           StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  enteredAt          DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([itemId, lotNumber])
  @@index([expiryDate])
  @@index([itemId])
  @@index([locationId])
  @@index([lotNumber])
  @@map("stock_lots")
}

enum StockExportType {
  ITEMS
  LOTS_EXPIRY
  CURRENT_STOCK
  CATEGORIES
  ONLINE_STORE
}

enum StockExportFormat {
  XLSX
  CSV
  PDF
}

enum StockExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

model StockExportJob {
  id             String            @id @default(cuid())
  sequentialId   Int               @unique @default(autoincrement())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           StockExportType
  format         StockExportFormat
  status         StockExportStatus @default(PENDING)
  fileName       String
  storedPath     String?
  mimeType       String?
  fileSizeBytes  Int?
  recordCount    Int?
  filtersJson    Json
  columnsJson    Json
  sortBy         String
  sortDir        String
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?
  downloadedAt   DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("stock_export_jobs")
}

enum SalesChannelPlatform {
  GENERIC
  CUSTOM
}

enum SalesChannelConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum OnlineListingPublishStatus {
  NOT_PUBLISHED
  PUBLISHED
  UNAVAILABLE
}

enum OnlineListingSyncStatus {
  SYNCED
  PENDING
  ERROR
}

enum OnlineStoreSyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

model SalesChannel {
  id               String                        @id @default(cuid())
  name             String
  platform         SalesChannelPlatform          @default(GENERIC)
  baseUrl          String?
  connectionStatus SalesChannelConnectionStatus  @default(DISCONNECTED)
  /// Hash/token opaco — nunca retornado ao frontend
  credentialsHash  String?
  hasCredentials   Boolean                       @default(false)
  lastSyncAt       DateTime?
  lastErrorMessage String?
  isDefault        Boolean                       @default(true)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  listings         OnlineStoreListing[]
  syncJobs         OnlineStoreSyncJob[]

  @@index([connectionStatus])
  @@map("sales_channels")
}

model OnlineStoreListing {
  id                 String                     @id @default(cuid())
  channelId          String
  channel            SalesChannel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  itemId             String
  item               StockItem                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  commercialName     String?
  shortDescription   String?
  storeDescription   String?
  storeCategory      String?
  tags               String?
  useErpPrice        Boolean                    @default(true)
  priceOverride      Decimal?                   @db.Decimal(18, 4)
  promoPrice         Decimal?                   @db.Decimal(18, 4)
  promoStartsAt      DateTime?
  promoEndsAt        DateTime?
  publishStatus      OnlineListingPublishStatus @default(NOT_PUBLISHED)
  syncStatus         OnlineListingSyncStatus    @default(PENDING)
  publishedStockQty  Decimal?                   @db.Decimal(18, 4)
  lastSyncedAt       DateTime?
  lastErrorCode      String?
  lastErrorMessage   String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([channelId, itemId])
  @@index([publishStatus])
  @@index([syncStatus])
  @@index([itemId])
  @@map("online_store_listings")
}

model OnlineStoreSyncJob {
  id                String                   @id @default(cuid())
  sequentialId      Int                      @unique @default(autoincrement())
  channelId         String
  channel           SalesChannel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncProducts      Boolean                  @default(true)
  syncStock         Boolean                  @default(true)
  syncPrices        Boolean                  @default(true)
  status            OnlineStoreSyncJobStatus @default(PENDING)
  productsProcessed Int                      @default(0)
  productsSuccess   Int                      @default(0)
  productsError     Int                      @default(0)
  stockUpdated      Int                      @default(0)
  pricesUpdated     Int                      @default(0)
  pendingCount      Int                      @default(0)
  summaryJson       Json?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([channelId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("online_store_sync_jobs")
}

enum CustomerDocumentType {
  CPF
  CNPJ
  OTHER
}

enum SaleCartStatus {
  OPEN
  CHECKOUT_PENDING
  HELD
  CLOSED
  CANCELLED
}

/// Meios habilitados no PDV. Novos valores só entram com integração real.
enum SalePaymentMethod {
  CASH
}

enum SalePaymentStatus {
  CONFIRMED
  CANCELLED
}

model Customer {
  id           String                @id @default(cuid())
  code         String
  name         String
  documentType CustomerDocumentType?
  document     String?
  email        String?
  phone        String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  carts        SaleCart[]
  receivables  AccountReceivable[]

  @@unique([code])
  @@index([name])
  @@index([document])
  @@index([active])
  @@map("customers")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SANGRIA
  SUPRIMENTO
}

model CashRegister {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  CashSession[]

  @@index([active])
  @@map("cash_registers")
}

model CashSession {
  id             String            @id @default(cuid())
  registerId     String
  register       CashRegister      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  operatorId     String
  operator       User              @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @db.Decimal(18, 4)
  closingAmount  Decimal?          @db.Decimal(18, 4)
  expectedAmount Decimal?          @db.Decimal(18, 4)
  difference     Decimal?          @db.Decimal(18, 4)
  notes          String?
  closingNotes   String?
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  movements      CashMovement[]

  @@index([registerId, status])
  @@index([operatorId, status])
  @@index([status])
  @@map("cash_sessions")
}

/// Preparado para sangria/suprimento — fluxo completo na F4 futura.
model CashMovement {
  id         String           @id @default(cuid())
  sessionId  String
  session    CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  operatorId String
  operator   User             @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  type       CashMovementType
  amount     Decimal          @db.Decimal(18, 4)
  reason     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([sessionId])
  @@index([type])
  @@map("cash_movements")
}

model SaleCart {
  id              String         @id @default(cuid())
  sequentialId    Int            @unique @default(autoincrement())
  status          SaleCartStatus @default(OPEN)
  operatorId      String
  operator        User           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartDiscount         Decimal                    @default(0) @db.Decimal(18, 4)
  cartDiscountManual   Boolean                    @default(false)
  cartSurcharge        Decimal                    @default(0) @db.Decimal(18, 4)
  notes                String?
  lastValidatedAt      DateTime?
  closedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  items                SaleCartItem[]
  payments             SalePayment[]
  receipt              SaleReceipt?
  appliedPromotions    SaleCartAppliedPromotion[]

  @@index([operatorId, status])
  @@index([customerId])
  @@index([status])
  @@map("sale_carts")
}

model SalePayment {
  id             String            @id @default(cuid())
  cartId         String
  cart           SaleCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  receiptId      String?
  receipt        SaleReceipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  method         SalePaymentMethod
  /// Valor aplicado à venda (não inclui troco).
  amount         Decimal           @db.Decimal(18, 4)
  /// Valor recebido do cliente (dinheiro).
  tenderedAmount Decimal?          @db.Decimal(18, 4)
  changeAmount   Decimal           @default(0) @db.Decimal(18, 4)
  status         SalePaymentStatus @default(CONFIRMED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([cartId])
  @@index([receiptId])
  @@index([method])
  @@map("sale_payments")
}

model SaleReceipt {
  id             String        @id @default(cuid())
  cartId         String        @unique
  cart           SaleCart      @relation(fields: [cartId], references: [id], onDelete: Restrict)
  sequentialId   Int
  operatorId     String
  customerId     String?
  subtotal       Decimal       @db.Decimal(18, 4)
  discounts      Decimal       @db.Decimal(18, 4)
  surcharges     Decimal       @db.Decimal(18, 4)
  total          Decimal       @db.Decimal(18, 4)
  amountPaid     Decimal       @db.Decimal(18, 4)
  changeAmount   Decimal       @default(0) @db.Decimal(18, 4)
  idempotencyKey String        @unique
  closedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       SalePayment[]

  @@index([operatorId])
  @@index([sequentialId])
  @@index([closedAt])
  @@map("sale_receipts")
}

model SaleCartItem {
  id                 String    @id @default(cuid())
  cartId             String
  cart               SaleCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  stockItemId        String
  stockItem          StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity           Decimal   @db.Decimal(18, 4)
  unitPrice          Decimal   @db.Decimal(18, 4)
  lineDiscount       Decimal   @default(0) @db.Decimal(18, 4)
  lineDiscountManual Boolean   @default(false)
  unitCode           String?
  productCode        String
  productDescription String
  sku                String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([cartId, stockItemId])
  @@index([cartId])
  @@index([stockItemId])
  @@map("sale_cart_items")
}

enum PromotionType {
  PERCENT
  FIXED
  PROMO_PRICE
  MIN_PURCHASE
}

enum PromotionScope {
  ALL
  PRODUCTS
  CATEGORIES
  BRANDS
}

enum PromotionStacking {
  STACKABLE
  EXCLUSIVE
}

enum PromotionStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CANCELLED
}

enum PromotionTargetKind {
  PRODUCT
  CATEGORY
  BRAND
}

model Promotion {
  id            String             @id @default(cuid())
  name          String
  description   String?
  type          PromotionType
  scope         PromotionScope     @default(ALL)
  stacking      PromotionStacking  @default(EXCLUSIVE)
  status        PromotionStatus    @default(DRAFT)
  priority      Int                @default(100)
  percentOff    Decimal?           @db.Decimal(18, 4)
  amountOff     Decimal?           @db.Decimal(18, 4)
  promoPrice    Decimal?           @db.Decimal(18, 4)
  minCartValue  Decimal?           @db.Decimal(18, 4)
  minQuantity   Decimal?           @db.Decimal(18, 4)
  maxQtyPerSale Decimal?           @db.Decimal(18, 4)
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  targets       PromotionTarget[]
  audits        PromotionAuditLog[]
  applications  SaleCartAppliedPromotion[]

  @@index([status])
  @@index([startsAt, endsAt])
  @@index([priority])
  @@map("promotions")
}

model PromotionTarget {
  id           String              @id @default(cuid())
  promotionId  String
  promotion    Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  kind         PromotionTargetKind
  targetId     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([promotionId, kind, targetId])
  @@index([targetId])
  @@map("promotion_targets")
}

model PromotionAuditLog {
  id           String     @id @default(cuid())
  promotionId  String?
  promotion    Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  actorId      String
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       String
  beforeJson   Json?
  afterJson    Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([promotionId])
  @@index([actorId])
  @@index([createdAt])
  @@map("promotion_audit_logs")
}

model SaleCartAppliedPromotion {
  id           String    @id @default(cuid())
  cartId       String
  cart         SaleCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  promotionId  String
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  lineId       String?
  amount       Decimal   @db.Decimal(18, 4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cartId])
  @@index([promotionId])
  @@map("sale_cart_applied_promotions")
}

enum ReceivableOrigin {
  MANUAL
  SALE
  CONTRACT
  OTHER
}

/// Status persistido. OPEN/PARTIAL derivados de vencimento viram DUE_TODAY/OVERDUE na leitura.
enum ReceivableStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
  RENEGOTIATED
}

enum ReceivableInstallmentStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
}

enum ReceivableMovementType {
  RECEIPT
  REVERSAL
}

model FinancePaymentMethod {
  id           String               @id @default(cuid())
  code         String
  label        String
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  receivables  AccountReceivable[]
  movements    ReceivableMovement[]
  payables     AccountPayable[]
  payableMovements PayableMovement[]

  @@unique([code])
  @@map("finance_payment_methods")
}

model BankAccount {
  id          String               @id @default(cuid())
  code        String
  name        String
  bankName    String?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  receivables AccountReceivable[]
  movements   ReceivableMovement[]
  payables    AccountPayable[]
  payableMovements PayableMovement[]

  @@unique([code])
  @@map("bank_accounts")
}

model CostCenter {
  id          String              @id @default(cuid())
  code        String
  name        String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  receivables AccountReceivable[]
  payables    AccountPayable[]

  @@unique([code])
  @@map("cost_centers")
}

model AccountReceivable {
  id                 String                    @id @default(cuid())
  sequentialId       Int                       @unique @default(autoincrement())
  customerId         String
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  origin             ReceivableOrigin          @default(MANUAL)
  originRef          String?
  description        String
  document           String?
  issueDate          DateTime                  @db.Date
  dueDate            DateTime                  @db.Date
  originalAmount     Decimal                   @db.Decimal(18, 4)
  discountAmount     Decimal                   @default(0) @db.Decimal(18, 4)
  interestAmount     Decimal                   @default(0) @db.Decimal(18, 4)
  fineAmount         Decimal                   @default(0) @db.Decimal(18, 4)
  paidAmount         Decimal                   @default(0) @db.Decimal(18, 4)
  status             ReceivableStatus          @default(OPEN)
  paymentMethodId    String?
  paymentMethod      FinancePaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  bankAccountId      String?
  bankAccount        BankAccount?              @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  costCenterId       String?
  costCenter         CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  installmentCount   Int                       @default(1)
  notes              String?
  createdById        String
  createdBy          User                      @relation("ReceivableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  renegotiatedFromId String?
  renegotiatedFrom   AccountReceivable?        @relation("ReceivableRenegotiation", fields: [renegotiatedFromId], references: [id], onDelete: SetNull)
  renegotiatedTo     AccountReceivable[]       @relation("ReceivableRenegotiation")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  installments       ReceivableInstallment[]
  movements          ReceivableMovement[]
  auditLogs          ReceivableAuditLog[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([origin])
  @@index([document])
  @@index([createdById])
  @@map("account_receivables")
}

model ReceivableInstallment {
  id             String                       @id @default(cuid())
  receivableId   String
  receivable     AccountReceivable            @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  number         Int
  dueDate        DateTime                     @db.Date
  amount         Decimal                      @db.Decimal(18, 4)
  paidAmount     Decimal                      @default(0) @db.Decimal(18, 4)
  discountAmount Decimal                      @default(0) @db.Decimal(18, 4)
  interestAmount Decimal                      @default(0) @db.Decimal(18, 4)
  fineAmount     Decimal                      @default(0) @db.Decimal(18, 4)
  status         ReceivableInstallmentStatus  @default(OPEN)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  movements      ReceivableMovement[]

  @@unique([receivableId, number])
  @@index([dueDate])
  @@index([status])
  @@map("receivable_installments")
}

model ReceivableMovement {
  id                 String               @id @default(cuid())
  receivableId       String
  receivable         AccountReceivable    @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  installmentId      String?
  installment        ReceivableInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  type               ReceivableMovementType
  amount             Decimal              @db.Decimal(18, 4)
  paidAt             DateTime             @db.Date
  paymentMethodId    String?
  paymentMethod      FinancePaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  bankAccountId      String?
  bankAccount        BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  interestAmount     Decimal              @default(0) @db.Decimal(18, 4)
  fineAmount         Decimal              @default(0) @db.Decimal(18, 4)
  discountAmount     Decimal              @default(0) @db.Decimal(18, 4)
  notes              String?
  operatorId         String
  operator           User                 @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  idempotencyKey     String?              @unique
  reversesMovementId String?
  reversesMovement   ReceivableMovement?  @relation("ReceivableReversal", fields: [reversesMovementId], references: [id], onDelete: SetNull)
  reversedBy         ReceivableMovement[] @relation("ReceivableReversal")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([receivableId, createdAt])
  @@index([installmentId])
  @@index([operatorId])
  @@index([type])
  @@map("receivable_movements")
}

model ReceivableAuditLog {
  id           String            @id @default(cuid())
  receivableId String?
  receivable   AccountReceivable? @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  actorId      String
  actor        User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       String
  amount       Decimal?          @db.Decimal(18, 4)
  message      String?
  payloadJson  Json?
  createdAt    DateTime          @default(now())

  @@index([receivableId, createdAt])
  @@index([actorId])
  @@map("receivable_audit_logs")
}

enum SupplierDocumentType {
  CPF
  CNPJ
  OTHER
}

enum PayableOrigin {
  MANUAL
  PURCHASE
  PURCHASE_ORDER
  CONTRACT
  OTHER
}

enum PayableStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
  RENEGOTIATED
}

enum PayableInstallmentStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
}

enum PayableMovementType {
  PAYMENT
  REVERSAL
}

enum PayableApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum PayableScheduleStatus {
  SCHEDULED
  EXECUTED
  CANCELLED
}

model Supplier {
  id           String                @id @default(cuid())
  code         String
  name         String
  documentType SupplierDocumentType?
  document     String?
  email        String?
  phone        String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  payables     AccountPayable[]

  @@unique([code])
  @@index([name])
  @@index([document])
  @@index([active])
  @@map("suppliers")
}

model ExpenseCategory {
  id        String           @id @default(cuid())
  code      String
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  payables  AccountPayable[]

  @@unique([code])
  @@map("expense_categories")
}

model AccountPayable {
  id                 String                 @id @default(cuid())
  sequentialId       Int                    @unique @default(autoincrement())
  supplierId         String
  supplier           Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  origin             PayableOrigin          @default(MANUAL)
  originRef          String?
  description        String
  document           String?
  categoryId         String?
  category           ExpenseCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  issueDate          DateTime               @db.Date
  dueDate            DateTime               @db.Date
  originalAmount     Decimal                @db.Decimal(18, 4)
  discountAmount     Decimal                @default(0) @db.Decimal(18, 4)
  interestAmount     Decimal                @default(0) @db.Decimal(18, 4)
  fineAmount         Decimal                @default(0) @db.Decimal(18, 4)
  paidAmount         Decimal                @default(0) @db.Decimal(18, 4)
  status             PayableStatus          @default(OPEN)
  approvalStatus     PayableApprovalStatus  @default(NONE)
  requiresApproval   Boolean                @default(false)
  paymentMethodId    String?
  paymentMethod      FinancePaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  bankAccountId      String?
  bankAccount        BankAccount?           @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  costCenterId       String?
  costCenter         CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  installmentCount   Int                    @default(1)
  notes              String?
  createdById        String
  createdBy          User                   @relation("PayableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  renegotiatedFromId String?
  renegotiatedFrom   AccountPayable?        @relation("PayableRenegotiation", fields: [renegotiatedFromId], references: [id], onDelete: SetNull)
  renegotiatedTo     AccountPayable[]       @relation("PayableRenegotiation")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  installments       PayableInstallment[]
  movements          PayableMovement[]
  schedules          PayableSchedule[]
  approvals          PayableApproval[]
  auditLogs          PayableAuditLog[]

  @@index([supplierId])
  @@index([status])
  @@index([approvalStatus])
  @@index([dueDate])
  @@index([origin])
  @@index([categoryId])
  @@index([document])
  @@index([createdById])
  @@map("account_payables")
}

model PayableInstallment {
  id             String                    @id @default(cuid())
  payableId      String
  payable        AccountPayable            @relation(fields: [payableId], references: [id], onDelete: Cascade)
  number         Int
  dueDate        DateTime                  @db.Date
  amount         Decimal                   @db.Decimal(18, 4)
  paidAmount     Decimal                   @default(0) @db.Decimal(18, 4)
  discountAmount Decimal                   @default(0) @db.Decimal(18, 4)
  interestAmount Decimal                   @default(0) @db.Decimal(18, 4)
  fineAmount     Decimal                   @default(0) @db.Decimal(18, 4)
  status         PayableInstallmentStatus  @default(OPEN)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  movements      PayableMovement[]

  @@unique([payableId, number])
  @@index([dueDate])
  @@index([status])
  @@map("payable_installments")
}

model PayableMovement {
  id                 String               @id @default(cuid())
  payableId          String
  payable            AccountPayable       @relation(fields: [payableId], references: [id], onDelete: Cascade)
  installmentId      String?
  installment        PayableInstallment?  @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  type               PayableMovementType
  amount             Decimal              @db.Decimal(18, 4)
  paidAt             DateTime             @db.Date
  paymentMethodId    String?
  paymentMethod      FinancePaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  bankAccountId      String?
  bankAccount        BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  interestAmount     Decimal              @default(0) @db.Decimal(18, 4)
  fineAmount         Decimal              @default(0) @db.Decimal(18, 4)
  discountAmount     Decimal              @default(0) @db.Decimal(18, 4)
  notes              String?
  operatorId         String
  operator           User                 @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  idempotencyKey     String?              @unique
  reversesMovementId String?
  reversesMovement   PayableMovement?     @relation("PayableReversal", fields: [reversesMovementId], references: [id], onDelete: SetNull)
  reversedBy         PayableMovement[]    @relation("PayableReversal")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([payableId, createdAt])
  @@index([installmentId])
  @@index([operatorId])
  @@index([type])
  @@map("payable_movements")
}

model PayableSchedule {
  id              String                @id @default(cuid())
  payableId       String
  payable         AccountPayable        @relation(fields: [payableId], references: [id], onDelete: Cascade)
  scheduledDate   DateTime              @db.Date
  amount          Decimal               @db.Decimal(18, 4)
  paymentMethodId String?
  bankAccountId   String?
  notes           String?
  status          PayableScheduleStatus @default(SCHEDULED)
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([payableId, scheduledDate])
  @@index([status])
  @@map("payable_schedules")
}

model PayableApproval {
  id           String                @id @default(cuid())
  payableId    String
  payable      AccountPayable        @relation(fields: [payableId], references: [id], onDelete: Cascade)
  status       PayableApprovalStatus
  amount       Decimal               @db.Decimal(18, 4)
  reason       String?
  actorId      String
  actor        User                  @relation("PayableApprover", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now())

  @@index([payableId, createdAt])
  @@index([actorId])
  @@map("payable_approvals")
}

model PayableAuditLog {
  id         String          @id @default(cuid())
  payableId  String?
  payable    AccountPayable? @relation(fields: [payableId], references: [id], onDelete: SetNull)
  actorId    String
  actor      User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  amount     Decimal?        @db.Decimal(18, 4)
  message    String?
  payloadJson Json?
  createdAt  DateTime        @default(now())

  @@index([payableId, createdAt])
  @@index([actorId])
  @@map("payable_audit_logs")
}
