{
  "name": "drogamar",
  "private": true,
  "version": "1.0.0",
  "description": "Drogamar monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run start:dev -w @drogamar/backend\" \"npm run dev -w @drogamar/frontend\"",
    "dev:frontend": "npm run dev -w @drogamar/frontend",
    "dev:backend": "npm run start:dev -w @drogamar/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build -w @drogamar/frontend",
    "build:backend": "npm run build -w @drogamar/backend",
    "lint": "npm run lint --workspaces --if-present",
    "start:backend": "npm run start:prod -w @drogamar/backend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:frontend": "docker compose -f apps/frontend/docker-compose.yml up --build",
    "docker:backend": "docker compose -f apps/backend/docker-compose.yml up --build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
