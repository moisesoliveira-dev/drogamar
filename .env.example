# PostgreSQL
POSTGRES_USER=drogamar
POSTGRES_PASSWORD=drogamar
POSTGRES_DB=drogamar
POSTGRES_PORT=5432

# Apps
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Backend auth
DATABASE_URL=postgresql://drogamar:drogamar@localhost:5432/drogamar?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Seed (dev only — troque em produção)
SEED_ADMIN_EMAIL=admin@drogamar.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
SEED_ADMIN_NAME=Administrador

# Exportações de estoque (F3)
EXPORT_STORAGE_PATH=storage/exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_RECORDS=50000
EXPORT_SYNC_THRESHOLD=1000
EXPORT_MAX_CONCURRENT_PER_USER=2

# F5 — Busca por IA (opcional). Sem chave, usa parser local + catálogo real.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
